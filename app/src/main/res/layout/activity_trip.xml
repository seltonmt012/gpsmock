<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/trip_subtitle"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/trip_mode" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeCar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_car" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeBike"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_bike" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeFoot"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_foot" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/trip_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/startInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/trip_search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startFromMap"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_from_map" />
        </LinearLayout>

        <TextView
            android:id="@+id/startResolved"
            style="@style/ResolvedLabel"
            android:text="@string/trip_not_set" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/trip_end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/endInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/trip_search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endFromMap"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_from_map" />
        </LinearLayout>

        <TextView
            android:id="@+id/endResolved"
            style="@style/ResolvedLabel"
            android:text="@string/trip_not_set" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/trip_times" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOutTime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trip_out_time" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnTime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/trip_return_time" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/trip_repeat" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetDaily"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/preset_daily"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetWeekdays"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/preset_weekdays"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetWeekend"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/preset_weekend"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetOnce"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="@string/preset_once"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/dayGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayMo"
                style="@style/DayToggle"
                android:text="@string/day_mo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayTu"
                style="@style/DayToggle"
                android:text="@string/day_tu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayWe"
                style="@style/DayToggle"
                android:text="@string/day_we" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayTh"
                style="@style/DayToggle"
                android:text="@string/day_th" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayFr"
                style="@style/DayToggle"
                android:text="@string/day_fr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/daySa"
                style="@style/DayToggle"
                android:text="@string/day_sa" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/daySu"
                style="@style/DayToggle"
                android:text="@string/day_su" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/repeatSummary"
            style="@style/ResolvedLabel"
            android:layout_marginTop="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPauseOutside"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/trip_pause_outside" />

        <TextView
            style="@style/ResolvedLabel"
            android:text="@string/trip_pause_outside_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/trip_autostart" />

        <TextView
            style="@style/ResolvedLabel"
            android:text="@string/trip_autostart_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoute"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/trip_calc"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/routeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/trip_activate"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestNow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/trip_test_now"
            app:cornerRadius="16dp" />

        <ProgressBar
            android:id="@+id/busy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
